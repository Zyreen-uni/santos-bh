{
  "name": "santos-boarding-house",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --reporter=default --reporter=json --outputFile=reports/vitest.json",
    "test:db": "node tests/db/run.mjs",
    "build": "vite build",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:db && npm run build && npm run test:e2e",
    "seed": "node scripts/seed.mjs",
    "format": "prettier --write .",
    "create-owner": "node scripts/create-owner.mjs",
    "catalog:backend": "node scripts/backend-catalog.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@vercel/blob": "^2.8.2",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
